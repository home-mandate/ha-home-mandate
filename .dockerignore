# Only sources go into the build context; local workspaces and build output stay out.
.git
.github
go.work
go.work.sum
bin
cover.out
*.test
**/node_modules
web/dist
web/coverage
web/test-results
web/playwright-report
web/src/lib/paraglide

# Never send secrets or local data to a (possibly remote) builder, at any depth.
**/.env*
**/*.pem
**/*.key
**/*.db
**/*.db-*
/data/
# A stale local UI build; the image builds its own.
internal/webui/dist/*
web/dist-pseudo
web/dist-mock
web/.env*.local
