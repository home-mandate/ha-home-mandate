{
  "type": "https://home-mandate.org/mandate/v0",
  "id": "m-conf-parameters",
  "principal": "household:conf",
  "agent": {
    "client_id": "urn:example:agent:conf-parameters",
    "display_name": "Conformance parameters"
  },
  "rules": [
    {
      "id": "r-arm-home",
      "resource": {
        "category": "alarm"
      },
      "actions": [
        "arm"
      ],
      "decision": "allow",
      "constraints": {
        "mode": {
          "one_of": [
            "home"
          ]
        }
      }
    },
    {
      "id": "r-range",
      "resource": {
        "category": "climate"
      },
      "actions": [
        "set_temperature"
      ],
      "decision": "allow",
      "constraints": {
        "temperature_high": {
          "max": 2400
        }
      }
    },
    {
      "id": "r-range-f",
      "resource": {
        "entity_id": "thermostat-f"
      },
      "actions": [
        "set_temperature"
      ],
      "decision": "allow",
      "constraints": {
        "temperature_low_f": {
          "min": 6000
        }
      }
    },
    {
      "id": "r-read",
      "resource": {
        "any": true
      },
      "actions": [
        "read"
      ],
      "decision": "allow"
    }
  ],
  "default": "deny",
  "approval": {
    "timeout": "PT2M",
    "approvers": [
      "approver-1"
    ]
  },
  "limits": {
    "max_actions_per_hour": 10
  },
  "valid_from": "2026-01-01T00:00:00+01:00",
  "created_by": "approver-1",
  "created_at": "2025-12-31T12:00:00+01:00"
}
