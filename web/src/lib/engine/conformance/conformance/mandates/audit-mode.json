{
  "type": "https://home-mandate.org/mandate/v0",
  "id": "m-conf-audit-mode",
  "principal": "household:conf",
  "agent": { "client_id": "urn:example:agent:conf-audit-mode", "display_name": "Conformance audit mode" },
  "enforce": false,
  "rules": [
    { "id": "r-lights", "resource": { "category": "light" }, "actions": ["read", "turn_on", "turn_off"], "decision": "allow" },
    { "id": "r-heating", "resource": { "category": "climate" }, "actions": ["set_temperature"], "decision": "allow",
      "constraints": { "temperature": { "min": 1600, "max": 2300 } } },
    { "id": "r-no-cameras", "resource": { "category": "camera" }, "actions": ["*"], "decision": "deny" },
    { "id": "r-locks", "resource": { "category": "lock" }, "actions": ["read", "lock"], "decision": "ask" },
    { "id": "r-door-switch", "resource": { "entity_id": "switch.door_opener" }, "actions": ["read"], "decision": "allow" },
    { "id": "r-alarm", "resource": { "category": "alarm" }, "actions": ["disarm"], "decision": "allow" }
  ],
  "default": "deny",
  "approval": { "timeout": "PT1M", "approvers": ["approver-1"] },
  "limits": { "max_actions_per_hour": 60 },
  "valid_from": "2026-01-01T00:00:00+01:00",
  "expires": "2027-01-01T00:00:00+01:00",
  "created_by": "approver-1",
  "created_at": "2025-12-31T12:00:00+01:00"
}
