{
  "type": "https://home-mandate.org/mandate/v0",
  "id": "m-conf-audit-mode-ask",
  "principal": "household:conf",
  "agent": { "client_id": "urn:example:agent:conf-audit-mode-ask", "display_name": "Conformance audit mode ask" },
  "enforce": false,
  "rules": [
    { "id": "r-ask-lights", "resource": { "category": "light" }, "actions": ["turn_on", "turn_off"], "decision": "ask" },
    { "id": "r-no-kids-room", "resource": { "entity_id": "light.kids_room" }, "actions": ["turn_on"], "decision": "deny" },
    { "id": "r-ask-covers", "resource": { "category": "cover" }, "actions": ["open"], "decision": "ask" },
    { "id": "r-ask-garage", "resource": { "entity_id": "cover.garage" }, "actions": ["open"], "decision": "ask",
      "approval": { "timeout": "PT5M", "approvers": ["approver-2"] } },
    { "id": "r-no-garage", "resource": { "entity_id": "cover.garage" }, "actions": ["open"], "decision": "deny" },
    { "id": "r-media", "resource": { "category": "media" }, "actions": ["play"], "decision": "allow" },
    { "id": "r-no-media", "resource": { "entity_id": "media.kids_room" }, "actions": ["play"], "decision": "deny" }
  ],
  "default": "deny",
  "approval": { "timeout": "PT1M", "approvers": ["approver-1"] },
  "limits": { "max_actions_per_hour": 60 },
  "valid_from": "2026-01-01T00:00:00+01:00",
  "created_by": "approver-1",
  "created_at": "2025-12-31T12:00:00+01:00"
}
