{
  "type": "https://home-mandate.org/mandate/v0",
  "id": "m-conf-constraints",
  "principal": "household:conf",
  "agent": { "client_id": "urn:example:agent:conf-constraints", "display_name": "Conformance constraints" },
  "rules": [
    { "id": "r-heating", "resource": { "category": "climate" }, "actions": ["set_temperature"], "decision": "allow",
      "constraints": { "temperature": { "min": 1600, "max": 2300 } } },
    { "id": "r-climate-mode", "resource": { "category": "climate" }, "actions": ["read", "set_mode"], "decision": "allow" },
    { "id": "r-volume-night", "resource": { "category": "media" }, "actions": ["set_volume"], "decision": "allow",
      "constraints": { "volume": { "max": 40 } }, "conditions": { "time_window": "22:00-07:00" } },
    { "id": "r-volume-day", "resource": { "category": "media" }, "actions": ["set_volume"], "decision": "allow",
      "conditions": { "time_window": "07:00-22:00" } },
    { "id": "r-blind", "resource": { "entity_id": "blind-1" }, "actions": ["set_position"], "decision": "allow",
      "constraints": { "position": { "min": 20 } } },
    { "id": "r-sauna-ask", "resource": { "entity_id": "sauna" }, "actions": ["set_temperature"], "decision": "ask" },
    { "id": "r-cellar-deny", "resource": { "area": "cellar" }, "actions": ["*"], "decision": "deny" }
  ],
  "default": "deny",
  "approval": { "timeout": "PT1M", "approvers": ["approver-1"] },
  "limits": { "max_actions_per_hour": 60 },
  "valid_from": "2026-01-01T00:00:00+01:00",
  "created_by": "approver-1",
  "created_at": "2025-12-31T12:00:00+01:00"
}
