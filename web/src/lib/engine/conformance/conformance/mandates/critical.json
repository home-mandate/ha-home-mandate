{
  "type": "https://home-mandate.org/mandate/v0",
  "id": "m-conf-critical",
  "principal": "household:conf",
  "agent": { "client_id": "urn:example:agent:conf-critical", "display_name": "Conformance critical" },
  "rules": [
    { "id": "r-scenes-read", "resource": { "category": "scene" }, "actions": ["read"], "decision": "allow" },
    { "id": "r-scene-morning", "resource": { "entity_id": "scene-morning" }, "actions": ["activate"], "decision": "allow" },
    { "id": "r-scene-evening", "resource": { "entity_id": "scene-evening" }, "actions": ["activate"], "decision": "allow",
      "allow_critical": true },
    { "id": "r-switches", "resource": { "category": "switch" }, "actions": ["read", "turn_on", "turn_off"], "decision": "allow" },
    { "id": "r-window", "resource": { "entity_id": "window-ground-floor" }, "actions": ["open"], "decision": "allow",
      "allow_critical": true },
    { "id": "r-heater-ask", "resource": { "entity_id": "heater-plug" }, "actions": ["turn_on"], "decision": "ask",
      "approval": { "timeout": "PT30S", "approvers": ["approver-2"] } },
    { "id": "r-pump-deny", "resource": { "entity_id": "pump-plug" }, "actions": ["turn_on"], "decision": "deny" },
    { "id": "r-lights", "resource": { "category": "light" }, "actions": ["turn_on", "turn_off"], "decision": "allow" },
    { "id": "r-bedroom-deny", "resource": { "area": "bedroom" }, "actions": ["*"], "decision": "deny" }
  ],
  "default": "deny",
  "approval": { "timeout": "PT1M", "approvers": ["approver-1"] },
  "limits": { "max_actions_per_hour": 60 },
  "valid_from": "2026-01-01T00:00:00+01:00",
  "created_by": "approver-1",
  "created_at": "2025-12-31T12:00:00+01:00"
}
