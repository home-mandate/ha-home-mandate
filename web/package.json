{
  "name": "home-mandate-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy globalVariable baseLocale --silent",
    "i18n:check": "node scripts/check-i18n.ts",
    "dev": "pnpm i18n:compile && vite",
    "build": "pnpm i18n:compile && vite build && node scripts/check-dist.ts",
    "build:mock": "pnpm i18n:compile && vite build --mode mock --outDir dist-mock && node scripts/check-dist.ts dist-mock --fixtures",
    "build:pseudo": "pnpm i18n:compile && vite build --mode pseudo --outDir dist-pseudo && node scripts/check-dist.ts dist-pseudo --fixtures",
    "lint": "pnpm i18n:compile && eslint .",
    "typecheck": "pnpm i18n:compile && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "test": "pnpm i18n:compile && vitest run --coverage",
    "e2e": "pnpm build:mock && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-icu1": "1.1.0",
    "@messageformat/parser": "5.1.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
